<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- Emit XML docs so the docs site's API reference can harvest them. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <!-- Shared from the host's Default load context so ISimulator/Knob/Plottable/LogEntry
             have one type identity across the plugin ALC boundary. -->
        <ProjectReference Include="..\Kernel\Kernel.csproj" />
    </ItemGroup>

</Project>
