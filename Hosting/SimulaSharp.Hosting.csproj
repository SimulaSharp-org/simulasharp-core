<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- Emit XML docs so the docs site's API reference can harvest them. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
        <Description>The loader for packed SimulaSharp simulations: a collectible-ALC plugin host (SimulatorPackage) for a runner/MMI. Not needed to author a simulation.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="" />
    </ItemGroup>

    <ItemGroup>
        <!-- Shared from the host's Default load context so ISimulator/Knob/Plottable/LogEntry
             have one type identity across the plugin ALC boundary. -->
        <ProjectReference Include="..\Kernel\Kernel.csproj" />
    </ItemGroup>

</Project>
