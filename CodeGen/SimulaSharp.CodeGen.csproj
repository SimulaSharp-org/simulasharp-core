<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <IsRoslynComponent>true</IsRoslynComponent>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <AssemblyName>SimulaSharp.CodeGen</AssemblyName>
        <RootNamespace>SimulaSharp.CodeGen</RootNamespace>
        <!-- RS2008: analyzer-release-tracking for the SIMxxx diagnostics; not packaging release notes.
             1591: allow not-yet-documented public members (the docs API reference harvests these XML docs). -->
        <NoWarn>$(NoWarn);RS2008;1591</NoWarn>
        <!-- Emit XML docs so the docs site's API reference can harvest them. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" PrivateAssets="all" />
        <PackageReference Include="YamlDotNet" Version="13.7.1" GeneratePathProperty="true" PrivateAssets="all" />
    </ItemGroup>

    <!-- Ship the <SimAssembly> item support so consumers auto-import it from the package. -->
    <ItemGroup>
        <None Include="build\SimulaSharp.CodeGen.targets" Pack="true" PackagePath="build\" />
    </ItemGroup>

    <!-- Bundle YamlDotNet.dll alongside the analyzer so it loads in the compiler process. -->
    <PropertyGroup>
        <GetTargetPathDependsOn>$(GetTargetPathDependsOn);GetDependencyTargetPaths</GetTargetPathDependsOn>
    </PropertyGroup>
    <Target Name="GetDependencyTargetPaths">
        <ItemGroup>
            <TargetPathWithTargetPlatformMoniker Include="$(PkgYamlDotNet)\lib\netstandard2.0\YamlDotNet.dll" IncludeRuntimeDependency="false" />
        </ItemGroup>
    </Target>

</Project>
