<Project>

    <!--
      Makes <SimAssembly Include="x.yaml"/> a first-class, IDE-recognized build action
      (like Antlr4's item), and bridges it to what the Roslyn generator can actually see:
      an AdditionalFiles item tagged IsSimAssembly, with that metadata made compiler-visible.
      Auto-imported when consumed as a NuGet package (build/<PackageId>.targets); for a
      ProjectReference, import this file explicitly.
    -->

    <ItemGroup>
        <AvailableItemName Include="SimAssembly" />
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="@(SimAssembly)" IsSimAssembly="true" />
        <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="IsSimAssembly" />
    </ItemGroup>

    <!--
      Packing: `dotnet pack` already puts the project's own assembly in lib/<tfm>/, but not its
      runtime deps.json or private dependency DLLs — which the host loader's
      AssemblyDependencyResolver needs to load the pack. Add them so the .nupkg is self-contained
      and restore-free to load. The main assembly, the shared SimulaSharp.* framework (loaded from
      the host's Default context), and framework assemblies are excluded.
    -->
    <PropertyGroup>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_SimulaSharpAddPackPayload</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <Target Name="_SimulaSharpAddPackPayload" DependsOnTargets="Build">
        <ItemGroup>
            <_SimPackPrivateDep Include="$(TargetDir)*.dll" Exclude="$(TargetDir)$(TargetFileName)" />
            <_SimPackPrivateDep Remove="$(TargetDir)SimulaSharp.*.dll" />

            <TfmSpecificPackageFile Include="@(_SimPackPrivateDep)">
                <PackagePath>lib/$(TargetFramework)/</PackagePath>
            </TfmSpecificPackageFile>
            <TfmSpecificPackageFile Include="$(TargetDir)$(AssemblyName).deps.json"
                                    Condition="Exists('$(TargetDir)$(AssemblyName).deps.json')">
                <PackagePath>lib/$(TargetFramework)/</PackagePath>
            </TfmSpecificPackageFile>
        </ItemGroup>
    </Target>

</Project>
