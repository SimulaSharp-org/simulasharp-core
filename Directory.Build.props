<Project>

  <!-- Shared package metadata + versioning for every project in the repo. Only packable projects
       (the libraries + the meta-package) actually produce a .nupkg; tests set IsPackable=false. -->
  <PropertyGroup>
    <Version>0.5.3</Version>
    <!-- Pinned so the ALC binding identity stays stable across patch releases: the MMI host and a packed sim
         plugin must load the SAME SimulaSharp identity across the collectible load context. Bump this ONLY on a
         binary-breaking change; <Version>/<FileVersion> keep moving per release. (FileVersion tracks <Version>.) -->
    <AssemblyVersion>0.5.0.0</AssemblyVersion>
    <Authors>Andreas Michelis</Authors>
    <Company>Andreas Michelis</Company>
    <Copyright>Copyright (c) 2026 Andreas Michelis</Copyright>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageTags>simulation;real-time;discrete-event;hardware-in-the-loop;actor;dotnet</PackageTags>

    <!-- Reproducible builds + symbol packages for debugging consumers. -->
    <Deterministic>true</Deterministic>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- The MIT LICENSE ships inside every package. Guarded so non-packable projects skip it. -->
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

</Project>
