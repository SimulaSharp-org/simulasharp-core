<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latestmajor</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>SimulaSharp.Kernel</AssemblyName>
        <RootNamespace>SimulaSharp.Kernel</RootNamespace>
        <!-- Emit XML docs so the docs site's API reference can harvest them. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
        <Description>The hard-real-time simulation runtime for SimulaSharp: clock, SimSites, event queue, coroutines, model/service base types, associations, and the observability surface. Pulled in transitively by the SimulaSharp meta-package.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="" />
    </ItemGroup>

    <ItemGroup>
        <!-- The test suite drives internals directly, to test each site in isolation. -->
        <InternalsVisibleTo Include="Kernel.Tests" />
    </ItemGroup>

</Project>
