<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latestmajor</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>SimulaSharp.Kernel</AssemblyName>
        <RootNamespace>SimulaSharp.Kernel</RootNamespace>
        <!-- Emit XML docs so the docs site's API reference can harvest them. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <!-- The test suite drives internals (e.g. LooselyCoupledSite.DrainInbox, normally only
             called by LooselyCoupledServiceBase) directly, to test each site in isolation. -->
        <InternalsVisibleTo Include="Kernel.Tests" />
    </ItemGroup>

</Project>
